<Window
    x:Class="AzHST.Desktop.Views.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AzHST.Application.Models"
    xmlns:vm="using:AzHST.Desktop.ViewModels"
    x:DataType="vm:SettingsWindowViewModel"
    Title="AzHST settings"
    Width="560"
    Height="550"
    CanResize="False"
    Icon="/Assets/azhst-icon.ico"
    Background="#0E162A"
    WindowStartupLocation="CenterOwner">

  <Grid Margin="28" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="6">
      <TextBlock
          FontSize="24"
          FontWeight="Bold"
          Foreground="#F5F8FF"
          Text="Configuration" />
      <TextBlock
          Foreground="#8FA4CB"
          Text="Choose output themes and how generated pages are opened." />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,26,0,0" Spacing="10">
      <TextBlock
          FontWeight="SemiBold"
          Foreground="#DCE7FF"
          Text="HTML visualization theme" />
      <ComboBox
          ItemsSource="{Binding HtmlThemeOptions}"
          SelectedItem="{Binding SelectedHtmlTheme, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:OutputThemeOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock
          Margin="0,6,0,0"
          FontWeight="SemiBold"
          Foreground="#DCE7FF"
          Text="PowerPoint theme" />
      <ComboBox
          ItemsSource="{Binding PresentationThemeOptions}"
          SelectedItem="{Binding SelectedPresentationTheme, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:OutputThemeOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock
          Margin="0,6,0,0"
          FontWeight="SemiBold"
          Foreground="#DCE7FF"
          Text="Generated pages root directory" />
      <TextBox
          PlaceholderText="Local application data directory"
          Text="{Binding OutputDirectory, Mode=TwoWay}" />
      <TextBlock
          Margin="0,0,0,12"
          FontSize="12"
          Foreground="#7186AD"
          Text="Leave empty to use the generated folder under the application's working directory." />

      <CheckBox
          Content="Also open each result in the default browser"
          IsChecked="{Binding OpenResultsInExternalBrowser, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel
        Grid.Row="2"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="10">
      <Button
          MinWidth="90"
          Click="Cancel_Click"
          Content="Cancel" />
      <Button
          MinWidth="110"
          Background="#2563EB"
          Click="Save_Click"
          Content="Save"
          Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
