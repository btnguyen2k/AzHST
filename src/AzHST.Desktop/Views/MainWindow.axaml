<Window
    x:Class="AzHST.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:vm="using:AzHST.Desktop.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="AzHST - Azure, visualized"
    Width="1440"
    Height="900"
    MinWidth="1040"
    MinHeight="700"
    Icon="/Assets/azhst-icon.ico"
    Background="#0B1020">

  <Window.Resources>
    <StreamGeometry x:Key="AccountIcon">
      M12,12 C14.761,12 17,9.761 17,7 C17,4.239 14.761,2 12,2 C9.239,2 7,4.239 7,7 C7,9.761 9.239,12 12,12 Z M12,14 C6.477,14 2,16.686 2,20 L2,22 L22,22 L22,20 C22,16.686 17.523,14 12,14 Z
    </StreamGeometry>
    <StreamGeometry x:Key="SettingsIcon">
      M2,4 L10,4 L10,6 L2,6 Z M14,2 L18,2 L18,8 L14,8 Z M18,4 L22,4 L22,6 L18,6 Z M2,11 L5,11 L5,13 L2,13 Z M9,9 L13,9 L13,15 L9,15 Z M13,11 L22,11 L22,13 L13,13 Z M2,18 L13,18 L13,20 L2,20 Z M17,16 L21,16 L21,22 L17,22 Z M21,18 L22,18 L22,20 L21,20 Z
    </StreamGeometry>
    <StreamGeometry x:Key="GenerateIcon">
      M14,2 L16.2,8.8 L23,11 L16.2,13.2 L14,20 L11.8,13.2 L5,11 L11.8,8.8 Z M4,14 L5.2,17.8 L9,19 L5.2,20.2 L4,24 L2.8,20.2 L0,19 L2.8,17.8 Z
    </StreamGeometry>
    <StreamGeometry x:Key="HomeIcon">
      M12,2 L22,10.5 L20.7,12 L19,10.6 L19,22 L14,22 L14,15 L10,15 L10,22 L5,22 L5,10.6 L3.3,12 L2,10.5 Z
    </StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#17213B" />
      <Setter Property="Foreground" Value="#DCE7FF" />
      <Setter Property="BorderBrush" Value="#2B3A61" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.example">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#121B31" />
      <Setter Property="Foreground" Value="#CFDAF2" />
      <Setter Property="BorderBrush" Value="#253454" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBox.query">
      <Setter Property="Background" Value="#0E162A" />
      <Setter Property="Foreground" Value="#F5F8FF" />
      <Setter Property="BorderBrush" Value="#33466F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="280,*">
    <Border
        Grid.Column="0"
        Padding="24"
        Background="#0E162A"
        BorderBrush="#1D2A45"
        BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="10">
          <TextBlock
              FontSize="24"
              FontWeight="Bold"
              Foreground="#F5F8FF"
              Text="AzHST" />
          <TextBlock
              Foreground="#8FA4CB"
              Text="Azure - How stuff works"
              TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0" Spacing="12">
          <TextBlock
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#7186AD"
              Text="GITHUB COPILOT" />
          <Border
              Padding="12"
              Background="#121D34"
              CornerRadius="8">
            <StackPanel Spacing="4">
              <TextBlock
                  FontWeight="SemiBold"
                  Foreground="#DCE7FF"
                  Text="{Binding AuthenticationMessage}"
                  TextWrapping="Wrap" />
              <TextBlock
                  FontSize="12"
                  Foreground="#7F94BB"
                  Text="Authentication is provided by GitHub CLI."
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button
              AutomationProperties.Name="{Binding GitHubSignInButtonText}"
              Classes="primary"
              Command="{Binding GitHubSignInCommand}">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
              <PathIcon
                  Width="16"
                  Height="16"
                  Data="{StaticResource AccountIcon}" />
              <TextBlock
                  VerticalAlignment="Center"
                  Text="{Binding GitHubSignInButtonText}" />
            </StackPanel>
          </Button>

          <Border Height="1" Margin="0,14" Background="#253454" />

          <TextBlock
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#7186AD"
              Text="CONFIGURATION" />
          <Border
              Padding="12"
              Background="#121D34"
              BorderBrush="#253454"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    FontSize="11"
                    Foreground="#7186AD"
                    Text="HTML Theme" />
                <TextBlock
                    FontSize="11"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"
                    Foreground="#DCE7FF"
                    Text="{Binding HtmlThemeName}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    FontSize="11"
                    Foreground="#7186AD"
                    Text="PowerPoint" />
                <TextBlock
                    FontSize="11"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"
                    Foreground="#DCE7FF"
                    Text="{Binding PresentationThemeName}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    FontSize="11"
                    Foreground="#7186AD"
                    Text="Open results" />
                <TextBlock
                    FontSize="11"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"
                    Foreground="#DCE7FF"
                    Text="{Binding ResultOpeningMode}" />
              </Grid>
            </StackPanel>
          </Border>
          <Button
              AutomationProperties.Name="Settings"
              Classes="secondary"
              Command="{Binding OpenSettingsCommand}">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
              <PathIcon
                  Width="16"
                  Height="16"
                  Data="{StaticResource SettingsIcon}" />
              <TextBlock
                  VerticalAlignment="Center"
                  Text="Settings" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
          <TextBlock
              FontSize="12"
              Foreground="#7186AD"
              Text="Generated pages are stored locally and restricted by a Content Security Policy."
              TextWrapping="Wrap" />
          <TextBlock
              FontSize="11"
              Foreground="#53698F"
              Text="{Binding ApplicationIdentityText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,24,30,26" RowDefinitions="Auto,*,Auto">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5">
            <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#60A5FA"
                Text="AZURE KNOWLEDGE VISUALIZER" />
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Foreground="#F8FAFF"
                Text="Understand cloud architecture at a glance"
                TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="10">
            <Button
                AutomationProperties.AutomationId="HomeButton"
                AutomationProperties.Name="Home"
                Classes="secondary"
                Command="{Binding GoHomeCommand}"
                IsVisible="{Binding HasPreview}">
              <StackPanel
                  HorizontalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="8">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="{StaticResource HomeIcon}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="Home" />
              </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="BuildPowerPointButton"
                Classes="primary"
                Command="{Binding BuildPowerPointCommand}"
                Content="Build PowerPoint"
                IsVisible="{Binding HasPreview}" />
            <Button
                AutomationProperties.AutomationId="OpenPowerPointButton"
                Classes="secondary"
                Command="{Binding OpenPresentationCommand}"
                Content="Open PowerPoint"
                IsVisible="{Binding HasPresentation}" />
            <Button
                Classes="secondary"
                Command="{Binding OpenExternalCommand}"
                Content="Open in browser"
                IsVisible="{Binding HasPreview}" />
          </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="10,8"
            Background="#10182C"
            BorderBrush="#2A3A5F"
            BorderThickness="1"
            CornerRadius="10"
            IsVisible="{Binding HasPresentation}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="#AFC0DF"
                Text="PowerPoint file" />
            <TextBox
                AutomationProperties.AutomationId="PowerPointFilePath"
                Grid.Column="1"
                Margin="12,0"
                VerticalContentAlignment="Center"
                Background="#0E162A"
                BorderBrush="#33466F"
                Foreground="#DCE7FF"
                IsReadOnly="True"
                Text="{Binding PresentationFilePath}" />
            <Button
                AutomationProperties.AutomationId="CopyPowerPointPathButton"
                Grid.Column="2"
                Margin="0,0,8,0"
                Classes="secondary"
                Command="{Binding CopyPresentationPathCommand}"
                Content="Copy path" />
            <Button
                AutomationProperties.AutomationId="OpenPowerPointFolderButton"
                Grid.Column="3"
                Classes="secondary"
                Command="{Binding OpenPresentationFolderCommand}"
                Content="Open folder" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Margin="0,24,0,22">
        <Border
            Padding="32"
            Background="#10182C"
            BorderBrush="#253454"
            BorderThickness="1"
            CornerRadius="16"
            IsVisible="{Binding ShowWelcome}">
          <ScrollViewer>
            <StackPanel
                MaxWidth="860"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
              <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="30"
                  FontWeight="Bold"
                  Foreground="#F5F8FF"
                  Text="Ask. Generate. Explore." />
              <TextBlock
                  HorizontalAlignment="Center"
                  Foreground="#9DB0D1"
                  Text="Ask about Azure services, compare options, or describe an architecture requirement. AzHST turns the answer into an interactive visual page."
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              <TextBlock
                  Margin="0,14,0,0"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#7186AD"
                  Text="TRY AN EXAMPLE" />
              <ItemsControl ItemsSource="{Binding SampleQueries}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SampleQueryOptionViewModel">
                    <Button
                        MinHeight="92"
                        Margin="5"
                        Padding="14,12"
                        VerticalContentAlignment="Stretch"
                        Classes="example"
                        Command="{Binding SelectCommand}">
                      <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#60A5FA"
                            Text="{Binding CategoryName}" />
                        <TextBlock
                            Foreground="#CFDAF2"
                            Text="{Binding Query}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border
            Background="White"
            BorderBrush="#33466F"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            IsVisible="{Binding HasEmbeddedPreview}">
          <ContentControl Content="{Binding EmbeddedPreviewUri}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="sys:Uri" x:DataType="sys:Uri">
                <NativeWebView
                    NavigationStarted="WebView_NavigationStarted"
                    NewWindowRequested="WebView_NewWindowRequested"
                    Source="{Binding .}" />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>

        <Border
            Padding="36"
            Background="#10182C"
            BorderBrush="#33466F"
            BorderThickness="1"
            CornerRadius="12"
            IsVisible="{Binding ShowPreviewFallback}">
          <StackPanel
              MaxWidth="620"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="16">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#F5F8FF"
                Text="Embedded preview unavailable" />
            <TextBlock
                Foreground="#9DB0D1"
                Text="{Binding WebViewAvailabilityMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Classes="primary"
                Command="{Binding OpenExternalCommand}"
                Content="Open in browser" />
          </StackPanel>
        </Border>
      </Grid>

      <Border
          Grid.Row="2"
          Padding="18"
          Background="#10182C"
          BorderBrush="#2A3A5F"
          BorderThickness="1"
          CornerRadius="14">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <TextBox
              AutomationProperties.AutomationId="QueryInput"
              Classes="query"
              AcceptsReturn="True"
              MaxHeight="150"
              MinHeight="84"
              PlaceholderText="Ask about an Azure service, comparison, integration, or target architecture..."
              Text="{Binding Query, Mode=TwoWay}"
              TextWrapping="Wrap" />
          <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock
                AutomationProperties.AutomationId="StatusMessage"
                VerticalAlignment="Center"
                Foreground="#8FA4CB"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="1"
                Margin="10,0"
                Classes="secondary"
                Command="{Binding GenerateCancelCommand}"
                Content="Cancel"
                IsVisible="{Binding IsGenerating}" />
            <Button
                Grid.Column="1"
                Margin="10,0"
                Classes="secondary"
                Command="{Binding BuildPowerPointCancelCommand}"
                Content="Cancel"
                IsVisible="{Binding IsBuildingPresentation}" />
            <Button
                AutomationProperties.AutomationId="GenerateButton"
                AutomationProperties.Name="Generate visualization"
                Grid.Column="2"
                Classes="primary"
                Command="{Binding GenerateCommand}">
              <StackPanel
                  HorizontalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="8">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="{StaticResource GenerateIcon}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="Generate visualization" />
              </StackPanel>
            </Button>
          </Grid>
          <ProgressBar
              Grid.Row="2"
              Height="3"
              Margin="0,12,0,0"
              IsIndeterminate="True"
              IsVisible="{Binding IsBusy}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
